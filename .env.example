# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://nilltechsolutions.com

# --- Supabase (DB / Auth / Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional + marketing email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@nilltechsolutions.com

# --- Cloudflare Turnstile (form spam protection) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Web Analytics site token (public, not a secret). Cloudflare
# dashboard > Analytics & Logs > Web Analytics > Add a site > copy the token
# from the JS snippet. The beacon only loads when this is set.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# --- Africa's Talking (SMS) ---
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# --- Persona (freelancer ID verification) ---
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=

# --- Website chat assistant (Anthropic, Claude Haiku). Monthly cap is in
# config/chat.ts (KES 1,000); also set a spend limit in the Anthropic console.
# Without it the chat answers from the site FAQs only. ---
ANTHROPIC_API_KEY=

# --- AI (quote/token estimators — cheapest capable model, hard spend cap enforced in code) ---
AI_PROVIDER_API_KEY=
AI_MONTHLY_SPEND_CAP_USD=

